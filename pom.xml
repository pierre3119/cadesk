<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.pierre3119</groupId>
  <artifactId>cadesk</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>CaDesk</name>
  <description>Application de bureau (Linux et Windows) : import des relevés CSV et OFX du Crédit Agricole dans une base SQLite, classement par catégories et bilan.</description>
  <url>https://github.com/pierre3119/cadesk</url>
  <inceptionYear>2026</inceptionYear>

  <developers>
    <developer>
      <id>pierre3119</id>
      <name>Pierre Duloy</name>
      <url>https://github.com/pierre3119</url>
      <properties>
        <linkedin>https://www.linkedin.com/in/pierre-duloy-2101929/</linkedin>
      </properties>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/pierre3119/cadesk</url>
    <connection>scm:git:https://github.com/pierre3119/cadesk.git</connection>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/pierre3119/cadesk/issues</url>
  </issueManagement>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <javafx.version>27.0.1</javafx.version>
    <atlantafx.version>3.0.0</atlantafx.version>
    <ikonli.version>12.4.0</ikonli.version>
    <sqlite-jdbc.version>3.54.1.0</sqlite-jdbc.version>
    <gson.version>2.15.0</gson.version>
    <pdfbox.version>3.0.8</pdfbox.version>
    <copilot-sdk.version>2.0.1</copilot-sdk.version>
    <slf4j.version>2.0.20</slf4j.version>
    <junit.version>6.1.3</junit.version>
    <assertj.version>3.27.7</assertj.version>

    <!-- Contrôles de qualité, exécutés à la phase « verify » (./build.sh verify, et l'intégration continue) -->
    <spotbugs-maven-plugin.version>4.10.5.0</spotbugs-maven-plugin.version>
    <findsecbugs.version>1.14.0</findsecbugs.version>
    <jacoco.version>0.8.16</jacoco.version>
    <!-- Part minimale des instructions exécutées par les tests, hors interface (ses tests sont à part : étiquette « ui ») -->
    <coverage.minimum>0.90</coverage.minimum>
    <!-- Options de la JVM des tests ; JaCoCo y ajoute son agent -->
    <argLine/>
    <!-- Construction reproductible : les fichiers de l'archive portent cette date, pas celle de la construction -->
    <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>

    <!-- Distribution lancée par start.sh / start.bat : cadesk.jar, lib/ (commun), lib/linux et lib/windows
         (parties natives : JavaFX et moteur de GitHub Copilot) -->
    <app.dir>${project.build.directory}/app</app.dir>
    <!-- Les tests d'interface (étiquette « ui ») demandent un affichage : exclus par défaut, voir README -->
    <excludedGroups>ui</excludedGroups>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.mkpaz</groupId>
      <artifactId>atlantafx-base</artifactId>
      <version>${atlantafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.kordamp.ikonli</groupId>
      <artifactId>ikonli-javafx</artifactId>
      <version>${ikonli.version}</version>
    </dependency>
    <dependency>
      <groupId>org.kordamp.ikonli</groupId>
      <artifactId>ikonli-feather-pack</artifactId>
      <version>${ikonli.version}</version>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite-jdbc.version}</version>
    </dependency>
    <!-- JSON : registre des profils, sauvegardes, échanges avec le LLM -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>${gson.version}</version>
    </dependency>
    <!-- Rapport PDF -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>${pdfbox.version}</version>
    </dependency>
    <!-- GitHub Copilot comme modèle de langage : SDK officiel. Son moteur natif, propre à chaque système,
         n'est pas une dépendance : il est copié plus bas dans lib/linux et lib/windows. -->
    <dependency>
      <groupId>com.microsoft</groupId>
      <artifactId>copilot-sdk</artifactId>
      <version>${copilot-sdk.version}</version>
    </dependency>
    <!-- sqlite-jdbc journalise via SLF4J : implémentation muette pour éviter l'avertissement au démarrage -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>${slf4j.version}</version>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>cadesk</finalName>
    <pluginManagement>
      <plugins>
        <plugin><artifactId>maven-clean-plugin</artifactId><version>3.5.0</version></plugin>
        <plugin><artifactId>maven-resources-plugin</artifactId><version>3.5.0</version></plugin>
        <plugin><artifactId>maven-compiler-plugin</artifactId><version>3.16.0</version></plugin>
        <plugin><artifactId>maven-surefire-plugin</artifactId><version>3.6.1</version></plugin>
        <plugin><artifactId>maven-jar-plugin</artifactId><version>3.5.1</version></plugin>
        <plugin><artifactId>maven-dependency-plugin</artifactId><version>3.11.0</version></plugin>
        <plugin><artifactId>maven-install-plugin</artifactId><version>3.2.0</version></plugin>
        <plugin><artifactId>maven-enforcer-plugin</artifactId><version>3.7.0</version></plugin>
        <plugin><groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId><version>${jacoco.version}</version></plugin>
        <plugin>
          <groupId>com.github.spotbugs</groupId>
          <artifactId>spotbugs-maven-plugin</artifactId>
          <version>${spotbugs-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>versions-requises</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                  <message>Java 25 ou plus est requis : lancez la construction avec build.sh / build.bat, qui utilisent le JDK embarqué.</message>
                </requireJavaVersion>
                <requireMavenVersion><version>[3.9,)</version></requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <showWarnings>true</showWarnings>
          <!-- aucun avertissement toléré : le code en est exempt, et doit le rester -->
          <failOnWarning>true</failOnWarning>
          <compilerArgs>
            <!-- sqlite-jdbc est un module automatique : avertissement attendu, donc désactivé -->
            <arg>-Xlint:all,-requires-automatic,-processing</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludedGroups>${excludedGroups}</excludedGroups>
          <!-- @{argLine} : lu à l'exécution, quand JaCoCo y a placé son agent -->
          <argLine>@{argLine} --enable-native-access=ALL-UNNAMED,javafx.graphics,org.xerial.sqlitejdbc</argLine>
          <systemPropertyVariables>
            <!-- dérivation des clés allégée : les tests créent beaucoup de mots de passe -->
            <cadesk.kdf.iterations>2000</cadesk.kdf.iterations>
            <!-- bibliothèques de la distribution, pour le test qui lance l'application comme le fait start.sh -->
            <cadesk.app.lib>${app.dir}/lib</cadesk.app.lib>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <outputDirectory>${app.dir}</outputDirectory>
        </configuration>
      </plugin>

      <!-- Couverture des tests : mesurée pendant les tests, rapport dans target/site/jacoco, et seuil à « verify » -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>rapport</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>seuil</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <!-- l'interface a ses propres tests, qui demandent d'être lancés à part -->
              <excludes><exclude>io/github/pierre3119/cadesk/ui/**</exclude></excludes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit><counter>INSTRUCTION</counter><value>COVEREDRATIO</value><minimum>${coverage.minimum}</minimum></limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Analyse statique du code compilé : défauts (SpotBugs) et failles de sécurité (Find Security Bugs).
           Ce qui est écarté l'est cas par cas, avec sa raison, dans spotbugs-exclude.xml. -->
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <configuration>
          <effort>Max</effort>
          <threshold>Medium</threshold>
          <excludeFilterFile>${project.basedir}/spotbugs-exclude.xml</excludeFilterFile>
          <plugins>
            <plugin>
              <groupId>com.h3xstream.findsecbugs</groupId>
              <artifactId>findsecbugs-plugin</artifactId>
              <version>${findsecbugs.version}</version>
            </plugin>
          </plugins>
        </configuration>
        <executions>
          <execution>
            <id>analyse-statique</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>

      <!-- Assemble la distribution : dépendances communes + parties natives (JavaFX, moteur de GitHub
           Copilot) pour CHAQUE système, afin qu'une seule construction (sous Linux ou sous Windows)
           tourne sur les deux. Les bibliothèques sont copiées avant les tests : l'un d'eux (LauncherTest)
           lance l'application sur elles, comme le fait start.sh. -->
      <plugin>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>bibliotheques-communes</id>
            <phase>process-test-classes</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <excludeGroupIds>org.openjfx</excludeGroupIds>
              <!-- annotations de compilation de Gson, inutiles à l'exécution -->
              <excludeArtifactIds>error_prone_annotations</excludeArtifactIds>
              <outputDirectory>${app.dir}/lib</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>natif-linux</id>
            <phase>process-test-classes</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <outputDirectory>${app.dir}/lib/linux</outputDirectory>
              <artifactItems>
                <artifactItem><groupId>org.openjfx</groupId><artifactId>javafx-base</artifactId><version>${javafx.version}</version><classifier>linux</classifier></artifactItem>
                <artifactItem><groupId>org.openjfx</groupId><artifactId>javafx-graphics</artifactId><version>${javafx.version}</version><classifier>linux</classifier></artifactItem>
                <artifactItem><groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId><version>${javafx.version}</version><classifier>linux</classifier></artifactItem>
                <artifactItem><groupId>com.microsoft</groupId><artifactId>copilot-sdk-runtime</artifactId><version>${copilot-sdk.version}</version><classifier>linux-x64</classifier></artifactItem>
              </artifactItems>
            </configuration>
          </execution>
          <execution>
            <id>natif-windows</id>
            <phase>process-test-classes</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <outputDirectory>${app.dir}/lib/windows</outputDirectory>
              <artifactItems>
                <artifactItem><groupId>org.openjfx</groupId><artifactId>javafx-base</artifactId><version>${javafx.version}</version><classifier>win</classifier></artifactItem>
                <artifactItem><groupId>org.openjfx</groupId><artifactId>javafx-graphics</artifactId><version>${javafx.version}</version><classifier>win</classifier></artifactItem>
                <artifactItem><groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId><version>${javafx.version}</version><classifier>win</classifier></artifactItem>
                <artifactItem><groupId>com.microsoft</groupId><artifactId>copilot-sdk-runtime</artifactId><version>${copilot-sdk.version}</version><classifier>win32-x64</classifier></artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
